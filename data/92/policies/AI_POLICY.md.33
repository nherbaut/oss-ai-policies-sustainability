  <script type="application/json" data-target="react-app.embeddedData">{"payload":{"codeViewBlobRoute":{"csv":null,"csvError":null,"headerInfo":{"toc":[{"level":1,"text":"Kiali Project AI Policy","anchor":"kiali-project-ai-policy","htmlText":"Kiali Project AI Policy"},{"level":2,"text":"Table of Contents","anchor":"table-of-contents","htmlText":"Table of Contents"},{"level":2,"text":"Purpose","anchor":"purpose","htmlText":"Purpose"},{"level":2,"text":"Scope","anchor":"scope","htmlText":"Scope"},{"level":2,"text":"Core Principles","anchor":"core-principles","htmlText":"Core Principles"},{"level":2,"text":"Guidelines for AI-Assisted Contributions","anchor":"guidelines-for-ai-assisted-contributions","htmlText":"Guidelines for AI-Assisted Contributions"},{"level":3,"text":"Permitted Uses","anchor":"permitted-uses","htmlText":"Permitted Uses"},{"level":3,"text":"Required Practices","anchor":"required-practices","htmlText":"Required Practices"},{"level":2,"text":"Community and Project Health","anchor":"community-and-project-health","htmlText":"Community and Project Health"},{"level":3,"text":"For New Contributors","anchor":"for-new-contributors","htmlText":"For New Contributors"},{"level":3,"text":"For Project Maintainers","anchor":"for-project-maintainers","htmlText":"For Project Maintainers"},{"level":2,"text":"Prohibited Practices","anchor":"prohibited-practices","htmlText":"Prohibited Practices"},{"level":2,"text":"Documentation and AI-Generated Content","anchor":"documentation-and-ai-generated-content","htmlText":"Documentation and AI-Generated Content"},{"level":3,"text":"Technical Documentation","anchor":"technical-documentation","htmlText":"Technical Documentation"},{"level":3,"text":"Design Documents and RFCs","anchor":"design-documents-and-rfcs","htmlText":"Design Documents and RFCs"},{"level":3,"text":"AI-Generated Images and Media","anchor":"ai-generated-images-and-media","htmlText":"AI-Generated Images and Media"},{"level":2,"text":"Project-Specific Considerations","anchor":"project-specific-considerations","htmlText":"Project-Specific Considerations"},{"level":2,"text":"Compliance with Employer Policies","anchor":"compliance-with-employer-policies","htmlText":"Compliance with Employer Policies"},{"level":2,"text":"Questions and Concerns","anchor":"questions-and-concerns","htmlText":"Questions and Concerns"},{"level":2,"text":"References","anchor":"references","htmlText":"References"},{"level":2,"text":"Acknowledgments","anchor":"acknowledgments","htmlText":"Acknowledgments"}]},"issueTemplate":null,"discussionTemplate":null,"richText":"\u003carticle class=\"markdown-body entry-content container-lg\" itemprop=\"text\"\u003e\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch1 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eKiali Project AI Policy\u003c/h1\u003e\u003ca id=\"user-content-kiali-project-ai-policy\" class=\"anchor\" aria-label=\"Permalink: Kiali Project AI Policy\" href=\"#kiali-project-ai-policy\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eTable of Contents\u003c/h2\u003e\u003ca id=\"user-content-table-of-contents\" class=\"anchor\" aria-label=\"Permalink: Table of Contents\" href=\"#table-of-contents\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e\u003ca href=\"#purpose\"\u003ePurpose\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"#scope\"\u003eScope\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"#core-principles\"\u003eCore Principles\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"#guidelines-for-ai-assisted-contributions\"\u003eGuidelines for AI-Assisted Contributions\u003c/a\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e\u003ca href=\"#permitted-uses\"\u003ePermitted Uses\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"#required-practices\"\u003eRequired Practices\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"#quality-standards\"\u003eQuality Standards\u003c/a\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"#community-and-project-health\"\u003eCommunity and Project Health\u003c/a\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e\u003ca href=\"#for-new-contributors\"\u003eFor New Contributors\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"#for-project-maintainers\"\u003eFor Project Maintainers\u003c/a\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"#prohibited-practices\"\u003eProhibited Practices\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"#documentation-and-ai-generated-content\"\u003eDocumentation and AI-Generated Content\u003c/a\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e\u003ca href=\"#technical-documentation\"\u003eTechnical Documentation\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"#design-documents-and-rfcs\"\u003eDesign Documents and RFCs\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"#ai-generated-images-and-media\"\u003eAI-Generated Images and Media\u003c/a\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"#project-specific-considerations\"\u003eProject-Specific Considerations\u003c/a\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e\u003ca href=\"#for-kiali-console-uifrontend\"\u003eFor Kiali Console (UI/Frontend)\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"#for-kiali-server-backend\"\u003eFor Kiali Server (Backend)\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"#for-kiali-operator\"\u003eFor Kiali Operator\u003c/a\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"#compliance-with-employer-policies\"\u003eCompliance with Employer Policies\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"#questions-and-concerns\"\u003eQuestions and Concerns\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"#references\"\u003eReferences\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"#acknowledgments\"\u003eAcknowledgments\u003c/a\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003ePurpose\u003c/h2\u003e\u003ca id=\"user-content-purpose\" class=\"anchor\" aria-label=\"Permalink: Purpose\" href=\"#purpose\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eThis AI Policy establishes guidelines for the use of Artificial Intelligence (AI) and Machine Learning (ML) tools in the development, documentation, and maintenance of the Kiali project. As a CNCF-aligned project in the Istio service mesh ecosystem, Kiali is committed to maintaining high standards of code quality, community engagement, and open source principles while embracing responsible innovation.\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eThis policy is aligned with the \u003ca href=\"https://www.linuxfoundation.org/legal/generative-ai\" rel=\"nofollow\"\u003eLinux Foundation's Generative AI Policy\u003c/a\u003e and \u003ca href=\"https://github.com/cncf/toc/issues/1803\" data-hovercard-type=\"issue\" data-hovercard-url=\"/cncf/toc/issues/1803/hovercard\"\u003eCNCF guidelines for AI-assisted open source projects\u003c/a\u003e.\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eThis policy should be read in conjunction with the Kiali project's \u003ca href=\"/kiali/kiali/blob/91a4bddfb6f200453c86a3febf6f50e3db340721/CONTRIBUTING.md\"\u003eCONTRIBUTING.md\u003c/a\u003e, \u003ca href=\"/kiali/kiali/blob/91a4bddfb6f200453c86a3febf6f50e3db340721/STYLE_GUIDE.adoc\"\u003eSTYLE_GUIDE.adoc\u003c/a\u003e, and \u003ca href=\"/kiali/kiali/blob/91a4bddfb6f200453c86a3febf6f50e3db340721/CODE_OF_CONDUCT.md\"\u003eCODE_OF_CONDUCT.md\u003c/a\u003e.\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eScope\u003c/h2\u003e\u003ca id=\"user-content-scope\" class=\"anchor\" aria-label=\"Permalink: Scope\" href=\"#scope\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eThis policy applies to:\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003eAll Kiali organization repositories and projects\u003c/li\u003e\n\u003cli\u003eCode contributions (including features, bug fixes, and refactoring)\u003c/li\u003e\n\u003cli\u003eDocumentation and technical writing\u003c/li\u003e\n\u003cli\u003eConfiguration files, scripts, and automation\u003c/li\u003e\n\u003cli\u003eTest code and test data\u003c/li\u003e\n\u003cli\u003eCommunity contributions and pull requests\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eCore Principles\u003c/h2\u003e\u003ca id=\"user-content-core-principles\" class=\"anchor\" aria-label=\"Permalink: Core Principles\" href=\"#core-principles\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003col dir=\"auto\"\u003e\n\u003cli\u003e\u003cstrong\u003eHuman Accountability\u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003eAll contributions must be reviewed, understood, and validated by human contributors\u003c/li\u003e\n\u003cli\u003eContributors remain fully responsible for the quality, security, and correctness of submitted code, regardless of how it was created\u003c/li\u003e\n\u003cli\u003eAI tools are assistants, not replacements for human judgment and expertise\u003c/li\u003e\n\u003c/ul\u003e\n\u003col start=\"2\" dir=\"auto\"\u003e\n\u003cli\u003e\u003cstrong\u003eOpen Source Values\u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003eContributions must align with \u003ca href=\"/kiali/kiali/blob/91a4bddfb6f200453c86a3febf6f50e3db340721/LICENSE\"\u003eKiali's open source license\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003eMaintain transparency in development practices\u003c/li\u003e\n\u003cli\u003eFoster genuine community collaboration and knowledge sharing\u003c/li\u003e\n\u003cli\u003eUphold the Code of Conduct and community values\u003c/li\u003e\n\u003c/ul\u003e\n\u003col start=\"3\" dir=\"auto\"\u003e\n\u003cli\u003e\u003cstrong\u003eQuality and Security\u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003eAll code must meet Kiali's quality standards and pass required reviews\u003c/li\u003e\n\u003cli\u003eSecurity considerations take precedence over development speed\u003c/li\u003e\n\u003cli\u003eComprehensive testing is required regardless of development method\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eGuidelines for AI-Assisted Contributions\u003c/h2\u003e\u003ca id=\"user-content-guidelines-for-ai-assisted-contributions\" class=\"anchor\" aria-label=\"Permalink: Guidelines for AI-Assisted Contributions\" href=\"#guidelines-for-ai-assisted-contributions\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003ePermitted Uses\u003c/h3\u003e\u003ca id=\"user-content-permitted-uses\" class=\"anchor\" aria-label=\"Permalink: Permitted Uses\" href=\"#permitted-uses\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eAI and ML tools (including but not limited to GitHub Copilot, ChatGPT, Claude, Cursor, and similar tools) may be used to assist with:\u003c/p\u003e\n\u003col dir=\"auto\"\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003eCode Development\u003c/strong\u003e\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003eGenerating boilerplate code and common patterns\u003c/li\u003e\n\u003cli\u003eSuggesting implementations for well-defined tasks\u003c/li\u003e\n\u003cli\u003eRefactoring existing code\u003c/li\u003e\n\u003cli\u003eWriting unit tests and test cases\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003eDocumentation\u003c/strong\u003e\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003eDrafting technical documentation\u003c/li\u003e\n\u003cli\u003eImproving clarity and grammar\u003c/li\u003e\n\u003cli\u003eGenerating API documentation templates\u003c/li\u003e\n\u003cli\u003eCreating examples and tutorials\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003eCode Review and Analysis\u003c/strong\u003e\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003eIdentifying potential bugs or security issues\u003c/li\u003e\n\u003cli\u003eSuggesting code improvements\u003c/li\u003e\n\u003cli\u003eExplaining complex code sections\u003c/li\u003e\n\u003cli\u003eAnalyzing code patterns\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003eDevelopment Assistance\u003c/strong\u003e\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003eDebugging and troubleshooting\u003c/li\u003e\n\u003cli\u003eResearching solutions to technical problems\u003c/li\u003e\n\u003cli\u003eUnderstanding unfamiliar codebases\u003c/li\u003e\n\u003cli\u003eGenerating regular expressions and queries\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003c/ol\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eRequired Practices\u003c/h3\u003e\u003ca id=\"user-content-required-practices\" class=\"anchor\" aria-label=\"Permalink: Required Practices\" href=\"#required-practices\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eWhen using AI tools to assist with contributions to Kiali projects, contributors \u003cstrong\u003eMUST\u003c/strong\u003e:\u003c/p\u003e\n\u003col dir=\"auto\"\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003eUnderstand the Code\u003c/strong\u003e\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003eThoroughly review all AI-generated code before submission\u003c/li\u003e\n\u003cli\u003eEnsure you understand what the code does and how it works\u003c/li\u003e\n\u003cli\u003eBe able to explain and defend the implementation in code reviews\u003c/li\u003e\n\u003cli\u003eYou take responsibility for the contribution's content and origin\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003eVerify License Compliance\u003c/strong\u003e\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003eEnsure AI tool terms and conditions do not conflict with \u003ca href=\"/kiali/kiali/blob/91a4bddfb6f200453c86a3febf6f50e3db340721/LICENSE\"\u003eKiali's license\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003eCheck if the AI tool's output restrictions are compatible with open source distribution\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003eAddress Third-Party Materials\u003c/strong\u003e\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003eIf AI output includes pre-existing copyrighted materials or code from third parties:\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003eVerify you have permission to use and modify such materials\u003c/li\u003e\n\u003cli\u003eEnsure the third-party material's license does not conflict with \u003ca href=\"/kiali/kiali/blob/91a4bddfb6f200453c86a3febf6f50e3db340721/LICENSE\"\u003eKiali's license\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003eProvide proper attribution and license information\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli\u003eConsider using AI tool features that suppress or flag responses similar to copyrighted materials\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003eTest Thoroughly\u003c/strong\u003e\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003eAI-assisted code must be accompanied by appropriate test code that validates its functionality\u003c/li\u003e\n\u003cli\u003eAll tests must pass before submission\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003eDisclose AI Assistance\u003c/strong\u003e\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003eContributors are \u003cstrong\u003eREQUIRED\u003c/strong\u003e to disclose when AI assistance was used to generate issues, pull requests, and commits\u003c/li\u003e\n\u003cli\u003eIn commit messages or pull request description fields, identify the code assistant that you used\u003c/li\u003e\n\u003cli\u003eUse a trailer such as \u003ccode\u003eAssisted-by:\u003c/code\u003e or \u003ccode\u003eGenerated-by:\u003c/code\u003e\u003c/li\u003e\n\u003cli\u003eExample for commits and PRs:\n\u003cdiv class=\"snippet-clipboard-content notranslate position-relative overflow-auto\" data-snippet-clipboard-copy-content=\"Assisted-by: Claude Code\"\u003e\u003cpre class=\"notranslate\"\u003e\u003ccode\u003eAssisted-by: Claude Code\n\u003c/code\u003e\u003c/pre\u003e\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003eIn source file comments, indicate the use of the code assistant\u003c/li\u003e\n\u003cli\u003eExample for source files:\n\u003cdiv class=\"snippet-clipboard-content notranslate position-relative overflow-auto\" data-snippet-clipboard-copy-content=\"# Generated-by: Cursor\"\u003e\u003cpre class=\"notranslate\"\u003e\u003ccode\u003e# Generated-by: Cursor\n\u003c/code\u003e\u003c/pre\u003e\u003c/div\u003e\nor\n\u003cdiv class=\"snippet-clipboard-content notranslate position-relative overflow-auto\" data-snippet-clipboard-copy-content=\"// Assisted-by: Claude Code\"\u003e\u003cpre class=\"notranslate\"\u003e\u003ccode\u003e// Assisted-by: Claude Code\n\u003c/code\u003e\u003c/pre\u003e\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003eBe transparent and honest about your development process\u003c/li\u003e\n\u003cli\u003eMaintainers may request additional information about code origin during reviews\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003c/ol\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eCommunity and Project Health\u003c/h2\u003e\u003ca id=\"user-content-community-and-project-health\" class=\"anchor\" aria-label=\"Permalink: Community and Project Health\" href=\"#community-and-project-health\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eFor New Contributors\u003c/h3\u003e\u003ca id=\"user-content-for-new-contributors\" class=\"anchor\" aria-label=\"Permalink: For New Contributors\" href=\"#for-new-contributors\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eAI tools can help newcomers learn and contribute, but contributions should demonstrate:\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e\u003cstrong\u003eGenuine Understanding\u003c/strong\u003e: Show familiarity with Kiali's purpose and architecture\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eCommunity Engagement\u003c/strong\u003e: Participate in discussions, ask questions, respond to feedback\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eIncremental Growth\u003c/strong\u003e: Build knowledge progressively rather than submitting large, unexplained changes\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eResponsiveness\u003c/strong\u003e: Address review feedback and iterate on contributions\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eFor Project Maintainers\u003c/h3\u003e\u003ca id=\"user-content-for-project-maintainers\" class=\"anchor\" aria-label=\"Permalink: For Project Maintainers\" href=\"#for-project-maintainers\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eMaintainers may ask about development methodology when code patterns suggest heavy AI assistance without understanding, security or correctness concerns arise, or contributions lack adequate explanation or testing. Contributors should respond honestly and transparently.\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eProhibited Practices\u003c/h2\u003e\u003ca id=\"user-content-prohibited-practices\" class=\"anchor\" aria-label=\"Permalink: Prohibited Practices\" href=\"#prohibited-practices\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eThe following practices are \u003cstrong\u003eNOT PERMITTED\u003c/strong\u003e:\u003c/p\u003e\n\u003col dir=\"auto\"\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003eBlind Submission\u003c/strong\u003e\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003eSubmitting AI-generated code without review or understanding\u003c/li\u003e\n\u003cli\u003eCopy-pasting AI output without verification\u003c/li\u003e\n\u003cli\u003eContributing code you cannot explain or maintain\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003eLicense Violations\u003c/strong\u003e\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003eUsing AI-generated code that violates license compatibility\u003c/li\u003e\n\u003cli\u003eIncluding copyrighted material without proper licensing\u003c/li\u003e\n\u003cli\u003eFailing to provide required attribution\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003eSecurity Negligence\u003c/strong\u003e\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003eSubmitting code with known security vulnerabilities\u003c/li\u003e\n\u003cli\u003eIgnoring security warnings or best practices\u003c/li\u003e\n\u003cli\u003eUsing AI to generate code handling secrets or credentials without proper review\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003eGaming the System\u003c/strong\u003e\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003eCreating artificial contribution velocity through bulk AI-generated submissions\u003c/li\u003e\n\u003cli\u003eSubmitting low-quality or redundant contributions to inflate metrics\u003c/li\u003e\n\u003cli\u003eUsing AI to simulate community engagement or discussions\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003eMisrepresentation\u003c/strong\u003e\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003eClaiming AI-generated work as entirely your own\u003c/li\u003e\n\u003cli\u003eFalsely attributing work to other contributors\u003c/li\u003e\n\u003cli\u003eProviding misleading information about code origin\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003c/ol\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eDocumentation and AI-Generated Content\u003c/h2\u003e\u003ca id=\"user-content-documentation-and-ai-generated-content\" class=\"anchor\" aria-label=\"Permalink: Documentation and AI-Generated Content\" href=\"#documentation-and-ai-generated-content\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eTechnical Documentation\u003c/h3\u003e\u003ca id=\"user-content-technical-documentation\" class=\"anchor\" aria-label=\"Permalink: Technical Documentation\" href=\"#technical-documentation\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003eAI-assisted documentation is permitted and encouraged for improving clarity\u003c/li\u003e\n\u003cli\u003eAll documentation must be technically accurate and reviewed by humans\u003c/li\u003e\n\u003cli\u003eContributors must verify examples and code snippets actually work\u003c/li\u003e\n\u003cli\u003eEnsure documentation aligns with current Kiali features and APIs\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eDesign Documents and RFCs\u003c/h3\u003e\u003ca id=\"user-content-design-documents-and-rfcs\" class=\"anchor\" aria-label=\"Permalink: Design Documents and RFCs\" href=\"#design-documents-and-rfcs\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003eAI tools may assist in drafting proposals and design documents\u003c/li\u003e\n\u003cli\u003eThe human author must thoroughly understand and support the proposed design\u003c/li\u003e\n\u003cli\u003eDesign decisions must reflect genuine technical reasoning, not just AI suggestions\u003c/li\u003e\n\u003cli\u003eCommunity discussion and iteration are essential components\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eAI-Generated Images and Media\u003c/h3\u003e\u003ca id=\"user-content-ai-generated-images-and-media\" class=\"anchor\" aria-label=\"Permalink: AI-Generated Images and Media\" href=\"#ai-generated-images-and-media\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e\u003cstrong\u003eTechnical Diagrams\u003c/strong\u003e: Flowcharts and technical illustrations generated by AI tools may be used if:\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003eThey accurately represent the content\u003c/li\u003e\n\u003cli\u003eThey are not copyrighted elsewhere\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003ePreferred Media\u003c/strong\u003e: Use original screenshots, diagrams created with standard tools, or properly licensed media\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eAvoid\u003c/strong\u003e: AI-generated decorative images or artwork due to copyright concerns\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eProject-Specific Considerations\u003c/h2\u003e\u003ca id=\"user-content-project-specific-considerations\" class=\"anchor\" aria-label=\"Permalink: Project-Specific Considerations\" href=\"#project-specific-considerations\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eAll AI-assisted contributions must follow the standards and testing requirements outlined in \u003ca href=\"/kiali/kiali/blob/91a4bddfb6f200453c86a3febf6f50e3db340721/CONTRIBUTING.md\"\u003eCONTRIBUTING.md\u003c/a\u003e and \u003ca href=\"/kiali/kiali/blob/91a4bddfb6f200453c86a3febf6f50e3db340721/STYLE_GUIDE.adoc\"\u003eSTYLE_GUIDE.adoc\u003c/a\u003e.\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eCompliance with Employer Policies\u003c/h2\u003e\u003ca id=\"user-content-compliance-with-employer-policies\" class=\"anchor\" aria-label=\"Permalink: Compliance with Employer Policies\" href=\"#compliance-with-employer-policies\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eContributors should also comply with their employer's policies regarding:\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003eUse of AI tools for code development\u003c/li\u003e\n\u003cli\u003eContribution to open source projects\u003c/li\u003e\n\u003cli\u003eIntellectual property rights\u003c/li\u003e\n\u003cli\u003eCode of conduct and ethical AI use\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp dir=\"auto\"\u003eIf your employer's policy conflicts with this policy, please discuss with Kiali maintainers before contributing.\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eQuestions and Concerns\u003c/h2\u003e\u003ca id=\"user-content-questions-and-concerns\" class=\"anchor\" aria-label=\"Permalink: Questions and Concerns\" href=\"#questions-and-concerns\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eIf you have questions about this policy or are unsure whether a particular use of AI tools is appropriate:\u003c/p\u003e\n\u003col dir=\"auto\"\u003e\n\u003cli\u003eAsk in the Kiali community channels (Slack, GitHub Discussions)\u003c/li\u003e\n\u003cli\u003eReach out to project maintainers\u003c/li\u003e\n\u003c/ol\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eReferences\u003c/h2\u003e\u003ca id=\"user-content-references\" class=\"anchor\" aria-label=\"Permalink: References\" href=\"#references\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eThis policy is based on and aligned with:\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e\u003ca href=\"https://www.linuxfoundation.org/legal/generative-ai\" rel=\"nofollow\"\u003eLinux Foundation Generative AI Policy\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"https://github.com/cncf/toc/issues/1803\" data-hovercard-type=\"issue\" data-hovercard-url=\"/cncf/toc/issues/1803/hovercard\"\u003eCNCF Guidelines for AI-Assisted Open Source Projects\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"https://www.cncf.io/reports/cloud-native-artificial-intelligence-whitepaper/\" rel=\"nofollow\"\u003eCNCF Cloud Native AI Whitepaper\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"https://opensource.org/osd/\" rel=\"nofollow\"\u003eOpen Source Definition\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"/kiali/kiali/blob/91a4bddfb6f200453c86a3febf6f50e3db340721/LICENSE\"\u003eKiali's LICENSE\u003c/a\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eAcknowledgments\u003c/h2\u003e\u003ca id=\"user-content-acknowledgments\" class=\"anchor\" aria-label=\"Permalink: Acknowledgments\" href=\"#acknowledgments\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eThe Kiali community recognizes that AI tools can accelerate development, improve code quality, and lower barriers to contribution. This policy aims to harness these benefits while maintaining the integrity, security, and collaborative spirit that make open source software thrive.\u003c/p\u003e\n\u003c/article\u003e","richTextTruncated":false,"renderedFileInfo":null,"symbols":{"timed_out":false,"not_analyzed":false,"symbols":[{"name":"Kiali Project AI Policy","fully_qualified_name":"Kiali Project AI Policy","kind":"section_1","ident_start":2,"ident_end":25,"extent_start":0,"extent_end":10830,"ident_utf16":{"start":{"line_number":0,"utf16_col":2},"end":{"line_number":0,"utf16_col":25}},"extent_utf16":{"start":{"line_number":0,"utf16_col":0},"end":{"line_number":241,"utf16_col":0}}},{"name":"Table of Contents","fully_qualified_name":"Table of Contents","kind":"section_2","ident_start":30,"ident_end":47,"extent_start":27,"extent_end":1267,"ident_utf16":{"start":{"line_number":2,"utf16_col":3},"end":{"line_number":2,"utf16_col":20}},"extent_utf16":{"start":{"line_number":2,"utf16_col":0},"end":{"line_number":28,"utf16_col":0}}},{"name":"Purpose","fully_qualified_name":"Purpose","kind":"section_2","ident_start":1270,"ident_end":1277,"extent_start":1267,"extent_end":2108,"ident_utf16":{"start":{"line_number":28,"utf16_col":3},"end":{"line_number":28,"utf16_col":10}},"extent_utf16":{"start":{"line_number":28,"utf16_col":0},"end":{"line_number":36,"utf16_col":0}}},{"name":"Scope","fully_qualified_name":"Scope","kind":"section_2","ident_start":2111,"ident_end":2116,"extent_start":2108,"extent_end":2419,"ident_utf16":{"start":{"line_number":36,"utf16_col":3},"end":{"line_number":36,"utf16_col":8}},"extent_utf16":{"start":{"line_number":36,"utf16_col":0},"end":{"line_number":46,"utf16_col":0}}},{"name":"Core Principles","fully_qualified_name":"Core Principles","kind":"section_2","ident_start":2422,"ident_end":2437,"extent_start":2419,"extent_end":3264,"ident_utf16":{"start":{"line_number":46,"utf16_col":3},"end":{"line_number":46,"utf16_col":18}},"extent_utf16":{"start":{"line_number":46,"utf16_col":0},"end":{"line_number":64,"utf16_col":0}}},{"name":"Guidelines for AI-Assisted Contributions","fully_qualified_name":"Guidelines for AI-Assisted Contributions","kind":"section_2","ident_start":3267,"ident_end":3307,"extent_star